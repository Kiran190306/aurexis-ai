# API Configuration
# For development: http://localhost:8000
# For production: Set to actual backend URL, e.g., https://api.jarvis-ai.com
VITE_API_URL=http://localhost:8000
VITE_API_V1_PREFIX=/api/v1
VITE_WS_URL=ws://localhost:8000

# Application
VITE_APP_NAME=Jarvis AI
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Authentication
VITE_JWT_SECRET=your-jwt-secret
VITE_TOKEN_REFRESH_INTERVAL=300000

# Feature Flags
VITE_ENABLE_BROWSE=true
VITE_ENABLE_TERMINAL=true
VITE_ENABLE_GITHUB=true
VITE_ENABLE_VOICE=true
VITE_ENABLE_IMAGE=true
VITE_ENABLE_DOCUMENT=true
VITE_ENABLE_CALENDAR=true
VITE_ENABLE_NOTIFICATIONS=true

# File Upload
VITE_MAX_UPLOAD_SIZE=104857600
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,txt,md,json,csv,xlsx,pptx,png,jpg,jpeg,gif,bmp,webp

# Analytics
VITE_ENABLE_ANALYTICS=true
VITE_GA_TRACKING_ID=

# Sentry
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# OAuth
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
VITE_GITHUB_OAUTH_CLIENT_ID=your-github-client-id
