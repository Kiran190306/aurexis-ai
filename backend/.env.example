# Application
APP_NAME=Jarvis AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
APP_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jarvis_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_MAX_CONNECTIONS=50

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=your-org-id
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=60

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT=60

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-pro
GOOGLE_TEMPERATURE=0.7
GOOGLE_MAX_TOKENS=4096
GOOGLE_TIMEOUT=60

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT=120

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-3-opus
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TIMEOUT=60

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=jarvis_memory
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACKED=true
CELERY_TASK_TIME_LIMIT=3600

# File Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=["pdf","doc","docx","txt","md","json","csv","xlsx","pptx","png","jpg","jpeg","gif","bmp","webp"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs
LOG_ROTATION=500 MB
LOG_RETENTION=30 days

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@jarvis-ai.com
SMTP_TLS=true

# OAuth2
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Browser Automation
SELENIUM_DRIVER=chrome
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT=30

# Voice
VOICE_ENABLED=true
VOICE_LANGUAGE=en-US
VOICE_STT_ENGINE=google
VOICE_TTS_ENGINE=google

# GitHub Integration
GITHUB_TOKEN=your-github-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Calendar
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google-calendar.json
GOOGLE_CALENDAR_TOKEN_PATH=./credentials/google-calendar-token.json

# Feature Flags
ENABLE_BROWSE=true
ENABLE_TERMINAL=true
ENABLE_GITHUB=true
ENABLE_VOICE=true
ENABLE_IMAGE=true
ENABLE_DOCUMENT=true
ENABLE_CALENDAR=true
ENABLE_NOTIFICATIONS=true

# Admin
ADMIN_EMAIL=admin@jarvis-ai.com
ADMIN_PASSWORD=change-this-password
